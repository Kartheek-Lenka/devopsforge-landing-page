# Public canonical URL of this marketing site (used for metadata + sitemap).
NEXT_PUBLIC_SITE_URL=https://devopsforge.co

# Origin of the main DevOpsForge application that CTAs link out to.
# Production: the app runs on its own subdomain.
# Local dev: set this to http://localhost:3000 while developing against the app.
NEXT_PUBLIC_APP_URL=https://app.devopsforge.co

# Optional: Google Analytics 4 measurement ID. If unset, no analytics script loads
# (click events are still pushed to window.dataLayer / gtag when present).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
